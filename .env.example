RDCMCP_APP_NAME=repo-dependency-context-mcp
RDCMCP_ENV=development
RDCMCP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rdcmcp
RDCMCP_REDIS_URL=redis://localhost:6379/0
RDCMCP_DEFAULT_TOP_K=5
RDCMCP_LOG_LEVEL=INFO
RDCMCP_VENDOR_OFFICIAL_DOMAINS=docs.python.org,fastapi.tiangolo.com,docs.sqlalchemy.org,docs.celeryq.dev,www.postgresql.org
RDCMCP_EMBEDDING_PROVIDER=local
RDCMCP_EMBEDDING_DIMENSION=1536
RDCMCP_OPENAI_API_KEY=
RDCMCP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RDCMCP_RERANK_PROVIDER=local
RDCMCP_OPENAI_RERANK_MODEL=gpt-5-mini
